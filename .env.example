# AI 面试助手 - 环境配置
# 复制此文件为 .env 并填入你的配置: cp .env.example .env

# ========== API Key (至少设置一个 LLM Key) ==========
# DeepSeek API Key (推荐) - https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# OpenAI API Key (可选) - https://platform.openai.com
# OPENAI_API_KEY=sk-your-openai-api-key-here

# 自定义 API 地址 (可选，用于代理或其他兼容 API)
# OPENAI_API_BASE=https://api.openai.com/v1

# ========== AI 模型配置 ==========
# LLM 提供商: openai / deepseek / custom
LLM_PROVIDER=deepseek

# LLM 模型名称 (deepseek-chat 速度最快, deepseek-reasoner 推理最强)
LLM_MODEL=deepseek-chat

# 回答温度 (0-2, 面试建议 0.6-0.8)
LLM_TEMPERATURE=0.7

# 回答最大长度 (tokens)
LLM_MAX_TOKENS=1024

# ========== 语音识别配置 ==========
# STT 提供商: xunfei (推荐, 线上) / local (离线) / openai
STT_PROVIDER=xunfei

# 讯飞语音听写 (IAT) - 前往 https://console.xfyun.cn 创建应用获取
IFLYTEK_APP_ID=your_app_id_here
IFLYTEK_API_KEY=your_api_key_here
IFLYTEK_API_SECRET=your_api_secret_here

# 本地 Whisper 模型 (仅 STT_PROVIDER=local): tiny / base / small / medium / large
LOCAL_WHISPER_MODEL=medium
LOCAL_WHISPER_DEVICE=cpu

# 识别语言: zh=中文, en=英语, 留空=自动检测
STT_LANGUAGE=zh

# ========== 音频输入配置 ==========
# loopback = 录制系统声音(面试官) / mic = 录制麦克风(你自己)
AUDIO_MODE=loopback

# 音频输入设备编号 (仅 mic 模式有效, -1=系统默认)
# AUDIO_DEVICE=1

# ========== 语音检测配置 ==========
# VAD 能量阈值 (0=自动校准, loopback 模式建议 100-300, mic 模式建议 50-200)
VAD_ENERGY_THRESHOLD=100

# 是否启用自适应阈值 (关闭后用固定阈值，更稳定)
VAD_ADAPTIVE=false

# 静音多少秒后认为说话结束
SILENCE_DURATION=1.5

# 最短说话时长 (秒)，短于此的语音会被忽略
MIN_SPEECH_DURATION=0.8

# ========== 快速回答模板 ==========
# 自我介绍 (匹配到面试官要求自我介绍时直接返回, 免 AI 调用)
# SELF_INTRO=面试官你好，我叫XXX...

# ========== Hugging Face 镜像 (国内网络, 仅本地 Whisper 模式) ==========
# HF_ENDPOINT=https://hf-mirror.com

# ========== 输出配置 ==========
# 是否启用文字转语音 (true/false)
ENABLE_TTS=false

# 对话历史保留轮数
MAX_HISTORY=5

# ========== 系统提示词 ==========
# 留空则自动读取程序目录下的简历文件生成专属提示词
# SYSTEM_PROMPT=自定义系统提示词
