# AI 面试助手 - 环境配置
# 复制此文件为 .env 并填入你的配置: cp .env.example .env

# ========== API Key (至少设置一个) ==========
# OpenAI API Key (用于 GPT 和 Whisper)
OPENAI_API_KEY=sk-your-openai-api-key-here

# DeepSeek API Key
DEEPSEEK_API_KEY=sk-24bbb12fa8644905a7a87ba2ee4a674f

# 自定义 API 地址 (可选，用于代理或其他兼容 API)
# OPENAI_API_BASE=https://api.openai.com/v1

# ========== AI 模型配置 ==========
# LLM 提供商: openai / deepseek / custom
LLM_PROVIDER=deepseek

# LLM 模型名称
LLM_MODEL=DeepSeek-v4-pro[1m]

# 回答温度 (0-2, 越高越有创意)
LLM_TEMPERATURE=2

# 回答最大长度 (tokens)
LLM_MAX_TOKENS=1024

# ========== 语音识别配置 ==========
# STT 提供商: openai / local / xunfei
STT_PROVIDER=xunfei

# 讯飞语音听写 (IAT) - 前往 https://console.xfyun.cn 创建应用获取
IFLYTEK_APP_ID=your_app_id_here
IFLYTEK_API_KEY=your_api_key_here
IFLYTEK_API_SECRET=your_api_secret_here

# 本地 Whisper 模型 (仅 STT_PROVIDER=local): tiny / base / small / medium / large
LOCAL_WHISPER_MODEL=medium
LOCAL_WHISPER_DEVICE=cpu

# 识别语言: zh=中文, en=英语, 留空=自动检测
STT_LANGUAGE=zh

# ========== 语音检测配置 ==========
# VAD 能量阈值 (0=自动校准, 手动设置建议 50-500)
VAD_ENERGY_THRESHOLD=0

# 是否启用自适应阈值 (true/false, 会自动根据环境噪声调整)
VAD_ADAPTIVE=true

# 静音多少秒后认为说话结束
SILENCE_DURATION=1.5

# 最短说话时长 (秒)，短于此的语音会被忽略
MIN_SPEECH_DURATION=0.5

# ========== 输出配置 ==========
# 是否启用文字转语音 (true/false)
ENABLE_TTS=false

# 对话历史保留轮数
MAX_HISTORY=5

# ========== 系统提示词 ==========
# 如需自定义 AI 的角色和行为，在下方的多行字符串中修改
# SYSTEM_PROMPT=你是一个专业的面试助手...
